        <mxCell id="TITLE" value="&lt;b&gt;IDEMA-2026-002 — Plataforma de Autogestion Academica&lt;/b&gt;&lt;br&gt;Esquema relacional normalizado — 15 tablas · BCNF / 5FN" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="-60" width="900" height="50" as="geometry"/></mxCell>
        <mxCell id="LEGEND" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;PK = clave primaria (subrayada) · FK = clave foranea · UK = unicidad · CK = clave candidata&lt;br&gt;Azul = entidad fuerte · Naranja = entidad debil/dependiente · Verde = tabla asociativa o multivaluado&lt;br&gt;Notacion pata de gallo: el lado N lleva la pata; el lado 1 lleva la barra&lt;br&gt;&lt;br&gt;&lt;b&gt;Unica correccion de normalizacion (2FN)&lt;/b&gt;&lt;br&gt;COMPROBANTE: PK (orden_id, id_comprobante) -&amp;gt; PK (orden_id).&lt;br&gt;orden_id es CK real por la relacion 1:1 parcial con ORDEN; el UK previo queda absorbido por la PK e id_comprobante pasa a atributo normal (sin UNIQUE global)." style="text;html=1;align=left;verticalAlign=top;fontSize=12;spacing=10;fillColor=#f5f5f5;strokeColor=#999999;rounded=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="700" height="180" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
