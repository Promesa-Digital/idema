# Copia este archivo a .env y ajusta los valores segun tu entorno.
#   cp .env.example .env
#
# URL base del backend FastAPI. Debe incluir el prefijo /api/v1,
# que es donde app/main.py monta el api_router.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Llave publica de Culqi (pk_test_... en desarrollo, pk_live_... en produccion).
# Es publica por diseno: viaja al navegador. La llave secreta va solo en el backend.
VITE_CULQI_PUBLIC_KEY=

# URL of the bienestar_idema backend's cita-intake endpoint.
# In dev, leave unset - the Vite dev proxy (see vite.config.ts) forwards
# requests to https://bienestar.idema.edu.pe.
# In production, leave unset to use the default
# (https://bienestar.idema.edu.pe/api/cita), or override it here.
VITE_CITA_ENDPOINT=https://bienestar.idema.edu.pe/api/cita
