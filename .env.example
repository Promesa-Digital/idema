# URL of the bienestar_idema backend's cita-intake endpoint.
# In dev, leave unset - the Vite dev proxy (see vite.config.ts) forwards
# requests to https://bienestar.idema.edu.pe.
# In production, leave unset to use the default
# (https://bienestar.idema.edu.pe/api/cita), or override it here.
VITE_CITA_ENDPOINT=https://bienestar.idema.edu.pe/api/cita